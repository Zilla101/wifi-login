# Copy to .env (which git ignores) and fill in.
NETWORK_NAME=Room WiFi

# Super admin: unlimited devices, can kick/block anyone. Created on first run.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Devices allowed per normal account
DEVICE_LIMIT=4

# iptables (this box is the gateway) | opennds (OpenWrt router) | dryrun (testing)
PORTAL_BACKEND=dryrun
# For opennds: run ndsctl on the router over ssh, e.g. root@192.168.1.1
PORTAL_SSH=
# Full address of the portal as phones see it, e.g. http://10.42.0.1:8080
PORTAL_URL=
PORT=8080
